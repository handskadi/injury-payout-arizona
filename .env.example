# review (default) shows labelled placeholders + pending reference content, noindex.
# production hides anything that hasn't passed its publication gate.
NEXT_PUBLIC_SITE_MODE=review

# demo (default): no lead endpoint, "Demo complete. No enquiry was sent."
# live: the form posts to /api/enquiry, which stores the lead in Supabase
#       (injury_payout_leads + injury_payout_lead_tracking), or else forwards it to INTAKE_WEBHOOK_URL.
NEXT_PUBLIC_INTAKE_MODE=demo

NEXT_PUBLIC_SITE_URL=https://injurypayout.com

# Live intake only — server secrets, never exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternative store when Supabase is not set:
INTAKE_WEBHOOK_URL=
INTAKE_WEBHOOK_SECRET=
